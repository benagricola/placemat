Board(
    name="usb-c-power-adapter",
    layout_path="layout",
    layers=4,
    config=BoardConfig(
        design_rules=DesignRules(
            constraints=Constraints(
                copper=Copper(
                    minimum_clearance=0.125,
                    minimum_track_width=0.125,
                    minimum_connection_width=0.0,
                    minimum_annular_width=0.125,
                    minimum_via_diameter=0.45,
                    copper_to_hole_clearance=0.2,
                    copper_to_edge_clearance=0.4,
                ),
                holes=Holes(minimum_through_hole=0.2, hole_to_hole_clearance=0.25),
                uvias=Uvias(minimum_uvia_diameter=0.2, minimum_uvia_hole=0.1),
                silkscreen=Silkscreen(minimum_item_clearance=0.0, minimum_text_height=0.7),
                solder_mask=SolderMask(to_copper_clearance=0.0),
                zones=Zones(minimum_clearance=0.25),
            ),
            predefined_sizes=PredefinedSizes(
                track_widths=[0.15, 0.2, 0.25, 0.3, 0.4, 0.5, 1.0, 1.5],
