# Protection: the input's reverse blocking, eFuse and current monitor, between
# the bike input at the tabs (VBIKE) and the protected rail (VSHUNT). A sheet
# of its own so its layout is one cell: the ideal-diode controller and its
# FET, the TPS16630 with its dividers, and the shunt with the INA226 at it.
# Layout facts (placemat-design Pm.*): roles, hot loops, aggressors, sensitive nets,
# full-load currents and dissipation, worked in
# ../../../../docs/decisions/schematics/power-stage-facts-2026-09-27.md.
C = Module("@stdlib/generics/Capacitor.zen")
EFUSE = Module("../../adapted/parts/Texas_Instruments_TPS16630PWPR.zen")
IDEAL = Module("../../adapted/parts/Texas_Instruments_LM74700QDBVRQ1.zen")
ISENSE = Module("../../adapted/parts/Texas_Instruments_INA226AIDGSR.zen")
# The reverse-blocking FET: ../../../../docs/decisions/schematics/input-reverse-fet-2026-09-27.md.
NFET = Module("../../adapted/parts/MDD_Microdiode_Semiconductor_MDDG06R10Q.zen")
R = Module("@stdlib/generics/Resistor.zen")
# The input shunt: ../../../../docs/decisions/schematics/input-shunt-2026-09-27.md.
SHUNT = Module("../../adapted/parts/YAGEO_PE1206DRM470R01L.zen")

gnd = io("GND", Net)
vbike = io("VBIKE", Net)
shunt = io("VSHUNT", Net)
v3v3 = io("V3V3", Net)
ina_alert = io("INA_ALERT", Net)
pgood = io("PGOOD", Net)
rail_fault = io("RAIL_FAULT", Net)
vprot_in = io("VPROT_IN", Net)
efuse_shdn = io("EFUSE_SHDN", Net)
rev_en = io("REV_EN", Net)
scl_pwr = io("SCL_PWR", Net)
sda_pwr = io("SDA_PWR", Net)

dvdt_set = Net("DVDT_SET")
ilim_set = Net("ILIM_SET")
ina_n = Net("INA_N")
ina_p = Net("INA_P")
ovp_set = Net("OVP_SET")
rev_cap = Net("REV_CAP")
rev_gate = Net("REV_GATE")
uvlo_set = Net("UVLO_SET")
vprot = Net("VPROT")

IDEAL(name = "revpol", ANODE = vbike, CATHODE = vprot_in, GATE = rev_gate,
      VCAP = rev_cap, GND = gnd, EN = rev_en)
NFET(name = "q_revpol", S = vbike, D = vprot_in, G = rev_gate,
     annotations = {"Pm.I": "VBIKE:4.6A VPROT_IN:4.6A", "Pm.Pd": "0.34W", "Pm.ThetaJa": "45C/W", "Pm.TjMax": "150C"})
C(name = "c_rev_cap", value = "100nF", package = "0402", voltage = "16V", mpn = "CL05B104KB54PNC", manufacturer = "Samsung Electro-Mechanics", annotations = {"LCSC": "C307331"},
  P1 = rev_cap, P2 = vbike)
# TPS16630 SHDN has an internal pull-up (2.48 V minimum, enable 2 V): the
# core is on unless the supervisor pulls it low (idle shutdown), and on
# while the supervisor is in reset. The supervisor also drives the LM74700's
# EN (REV_EN). ../../../../docs/decisions/schematics/idle-shutdown-2026-09-28.md.
EFUSE(name = "efuse", IN = vprot_in, P_IN = vprot_in, OUT = vprot, GND = gnd,
      EP = gnd, UVLO = uvlo_set, OVP = ovp_set, ILIM = ilim_set, MODE = gnd,
      dVdT = dvdt_set, FLT = rail_fault, PGOOD = pgood,
      N_C = NotConnected(), IMON = NotConnected(), SHDN = efuse_shdn,
      annotations = {"Pm.I": "VPROT_IN:4.6A VPROT:4.6A", "Pm.Pd": "1.1W", "Pm.ThetaJb": "10.2C/W", "Pm.TjMax": "125C"})
C(name = "c_vprot_in", value = "100nF", package = "0402", voltage = "50V", mpn = "CL05B104KB54PNC", manufacturer = "Samsung Electro-Mechanics", P1 = vprot_in, P2 = gnd,
  annotations = {"LCSC": "C307331", "Pm.Role": "bypass"})
C(name = "c_vprot", value = "100nF", package = "0402", voltage = "50V", mpn = "CL05B104KB54PNC", manufacturer = "Samsung Electro-Mechanics", P1 = vprot, P2 = gnd,
  annotations = {"LCSC": "C307331", "Pm.Role": "output"})
R(name = "r_div_top", value = "1.2Mohm", package = "0402", P1 = vprot_in, P2 = uvlo_set)
R(name = "r_div_mid", value = "200kohm", package = "0402", P1 = uvlo_set, P2 = ovp_set)
R(name = "r_div_bot", value = "100kohm", package = "0402", P1 = ovp_set, P2 = gnd)
R(name = "r_ilim", value = "4.7kohm", package = "0402", P1 = ilim_set, P2 = gnd)
R(name = "r_pgood", value = "100kohm", package = "0402", P1 = v3v3, P2 = pgood)
C(name = "c_dvdt", value = "10nF", package = "0402", mpn = "CL05B103KB5NNNC", manufacturer = "Samsung Electro-Mechanics", annotations = {"LCSC": "C15195"}, P1 = dvdt_set, P2 = gnd)
# 10 mOhm, 0.5 %, 75 ppm/C, 1 W, on Yageo's recommended land.
SHUNT(name = "r_shunt", P1 = vprot, P2 = shunt,
      annotations = {"Pm.Role": "sense", "Pm.I": "4.6A", "Pm.Pd": "0.21W"})
R(name = "r_ina_p", value = "10ohm", package = "0402", P1 = vprot, P2 = ina_p,
  annotations = {"Pm.Role": "sense", "Pm.Sensitive": "INA_P"})
R(name = "r_ina_n", value = "10ohm", package = "0402", P1 = shunt, P2 = ina_n,
  annotations = {"Pm.Role": "sense", "Pm.Sensitive": "INA_N"})
# One differential capacitor across the inputs (INA226 SBOS547C Figure 6-3):
# ../../../../docs/decisions/schematics/ina226-input-filter-screen-2026-09-27.md.
C(name = "c_ina", value = "100nF", package = "0402", voltage = "50V", dielectric = "X7R",
  mpn = "CL05B104KB54PNC", manufacturer = "Samsung Electro-Mechanics", annotations = {"LCSC": "C307331"}, P1 = ina_p, P2 = ina_n)
ISENSE(name = "isense", VS_P = v3v3, GND = gnd, VIN_P = ina_p, VIN_N = ina_n,
       SDA = sda_pwr, SCL = scl_pwr, Alert = ina_alert, A0 = gnd, A1 = gnd,
       VBUS = vprot)
C(name = "c_isense", value = "100nF", package = "0402", mpn = "CL05B104KB54PNC", manufacturer = "Samsung Electro-Mechanics", annotations = {"LCSC": "C307331"}, P1 = v3v3, P2 = gnd)
# Laid out once by Protection_layout.py into protection/ and stamped onto the
# core as a cell.
load("../../board_rules.zen", "CONFIG", "LAYERS")

# A Board() rather than a Layout(), so the fragment is laid out by the core's
# design rules (board_rules.zen). Its project registers only when this file
# is built on its own.
Board(name = "Protection", layout_path = "layout", layers = LAYERS, config = CONFIG)

Project(name = "Input protection and monitor", path = "kicad", schematic = True, layout = False)
