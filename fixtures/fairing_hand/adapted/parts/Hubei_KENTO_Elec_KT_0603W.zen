# Hubei_KENTO_Elec_KT_0603W - component wrapper: local KiCad symbol + footprint, LCSC pinned
# in properties (feeds the JLC BOM/CPL fields). Datasheet: Hubei_KENTO_Elec-KT_0603W_C2290.pdf

K = io("K", Net, optional = True)
A = io("A", Net, optional = True)

annotations = config(dict, default = {}, optional = True,
                     help = "Pm.* layout facts (placemat-design): forwarded into the footprint's fields")
_properties = {"LCSC": "C2290", "MPN": "KT-0603W"}
_properties.update(annotations)

Component(
    name = "Hubei_KENTO_Elec_KT_0603W",
    footprint = File("../../parts/Hubei_KENTO_Elec_KT_0603W/LED0603-R-RD_WHITE.kicad_mod"),
    symbol = Symbol("Hubei_KENTO_Elec_KT_0603W/KT_0603W.kicad_sym"),
    prefix = "U",
    part = Part(mpn = "KT-0603W", manufacturer = "Hubei KENTO Elec"),
    properties = _properties,
    pins = {
        "K": K,
        "A": A,
    },
)
