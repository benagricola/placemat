# MDD_Microdiode_Semiconductor_MDDG06R10Q - component wrapper: local KiCad symbol + footprint, LCSC pinned
# in properties (feeds the JLC BOM/CPL fields). Datasheet: MDD_Microdiode_Semiconductor-MDDG06R10Q_C52754283.pdf

S = io("S", Net, optional = True)
G = io("G", Net, optional = True)
D = io("D", Net, optional = True)

annotations = config(dict, default = {}, optional = True,
                     help = "Pm.* layout facts (placemat-design): forwarded into the footprint's fields")
_properties = {"LCSC": "C52754283", "MPN": "MDDG06R10Q"}
_properties.update(annotations)

Component(
    name = "MDD_Microdiode_Semiconductor_MDDG06R10Q",
    footprint = File("../../parts/MDD_Microdiode_Semiconductor_MDDG06R10Q/DFN-8_L3.3-W3.3-P0.65-BL.kicad_mod"),
    symbol = Symbol("MDD_Microdiode_Semiconductor_MDDG06R10Q/MDDG06R10Q.kicad_sym"),
    prefix = "U",
    part = Part(mpn = "MDDG06R10Q", manufacturer = "MDD (Microdiode Semiconductor)"),
    properties = _properties,
    pins = {
        "S": S,
        "G": G,
        "D": D,
    },
)
