# Texas_Instruments_SN74LVC1G08DRYR - component wrapper: local KiCad symbol + footprint, LCSC pinned
# in properties (feeds the JLC BOM/CPL fields). Datasheet: Texas_Instruments-SN74LVC1G08DRYR_C2682083.pdf

A = io("A", Net, optional = True)
B = io("B", Net, optional = True)
GND = io("GND", Net, optional = True)
Y = io("Y", Net, optional = True)
NC = io("NC", Net, optional = True)
VCC = io("VCC", Net, optional = True)

annotations = config(dict, default = {}, optional = True,
                     help = "Pm.* layout facts (placemat-design): forwarded into the footprint's fields")
_properties = {"LCSC": "C2682083", "MPN": "SN74LVC1G08DRYR"}
_properties.update(annotations)

Component(
    name = "Texas_Instruments_SN74LVC1G08DRYR",
    footprint = File("../../parts/Texas_Instruments_SN74LVC1G08DRYR/SON-6_L1.5-W1.0-P0.50-BL.kicad_mod"),
    symbol = Symbol("Texas_Instruments_SN74LVC1G08DRYR/SN74LVC1G08DRYR.kicad_sym"),
    prefix = "U",
    part = Part(mpn = "SN74LVC1G08DRYR", manufacturer = "Texas Instruments"),
    properties = _properties,
    pins = {
        "A": A,
        "B": B,
        "GND": GND,
        "Y": Y,
        "NC": NC,
        "VCC": VCC,
    },
)
