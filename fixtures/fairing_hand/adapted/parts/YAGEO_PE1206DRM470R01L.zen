# YAGEO PE1206DRM470R01L: 10 mOhm, 0.5 %, 75 ppm/C, 1 W current sensor, on Yageo's
# recommended PE1206 land (PE series V.13 Fig. 19, Table 8), not EasyEDA's.
# Land provenance: YAGEO_PE1206DRM470R01L/land-pattern-provenance.json.

P1 = io("P1", Net, optional = True)
P2 = io("P2", Net, optional = True)

annotations = config(dict, default = {}, optional = True,
                     help = "Pm.* layout facts (placemat-design): forwarded into the footprint's fields")
_properties = {"LCSC": "C4144857", "MPN": "PE1206DRM470R01L"}
_properties.update(annotations)

Component(
    name = "YAGEO_PE1206DRM470R01L",
    footprint = File("YAGEO_PE1206DRM470R01L/PE1206_Yageo_Table8.kicad_mod"),
    symbol = Symbol("YAGEO_PE1206DRM470R01L/PE1206DRM470R01L.kicad_sym"),
    prefix = "R",
    part = Part(mpn = "PE1206DRM470R01L", manufacturer = "YAGEO"),
    properties = _properties,
    pins = {
        "1": P1,
        "2": P2,
    },
)
