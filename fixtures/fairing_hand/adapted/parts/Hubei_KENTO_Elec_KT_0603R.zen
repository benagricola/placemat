# Hubei_KENTO_Elec_KT_0603R - component wrapper: local KiCad symbol + footprint, LCSC pinned
# in properties (feeds the JLC BOM/CPL fields). Datasheet: Hubei_KENTO_Elec-KT_0603R_C2286.pdf

K = io("K", Net, optional = True)
A = io("A", Net, optional = True)

annotations = config(dict, default = {}, optional = True,
                     help = "Pm.* layout facts (placemat-design): forwarded into the footprint's fields")
_properties = {"LCSC": "C2286", "MPN": "KT-0603R"}
_properties.update(annotations)

Component(
    name = "Hubei_KENTO_Elec_KT_0603R",
    footprint = File("../../parts/Hubei_KENTO_Elec_KT_0603R/LED-SMD_L1.6-W0.8-R-RD.kicad_mod"),
    symbol = Symbol("Hubei_KENTO_Elec_KT_0603R/KT_0603R.kicad_sym"),
    prefix = "U",
    part = Part(mpn = "KT-0603R", manufacturer = "Hubei KENTO Elec"),
    properties = _properties,
    pins = {
        "K": K,
        "A": A,
    },
)
