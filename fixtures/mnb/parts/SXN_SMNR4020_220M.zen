# SXN_SMNR4020_220M — component wrapper: local KiCad symbol + footprint, LCSC
# pinned in properties (feeds the JLC BOM/CPL fields).
#
# 22 uH shielded power inductor, 4.0 x 4.0 x ~1.65 mm, 1.05 A saturation and
# 1.05 A rms, 455 mOhm. The LOW-PROFILE, LIGHT-RAIL alternative to the
# SMMS0630 in `modules/Buck_SY8513FCC` (7.1 x 6.6 x 3.0, 2.6 A rms / 3.5 A sat).
#
# WHERE IT IS VALID: peak inductor current is Iout + ripple/2, and ripple on a
# big step-down is small - a 48 V to 5 V rail at 300 kHz runs 0.68 A p-p, so a
# 0.5 A load peaks at 0.84 A. Against 1.05 A saturation that is 25% margin at
# room temperature and less at this ecosystem's 100 C sealed ambient, so it
# suits a rail specified at 0.5 A or below and NOT the 48 V to 24 V rail, whose
# 0.5 duty cycle gives 1.81 A p-p and a 1.9 A peak at 1 A.
#
# Its 455 mOhm costs about 3x the SMMS0630's copper loss per amp, which at
# these currents is tens of milliwatts - the trade buys 32 mm2 of board and
# 1.35 mm of height.
# Pinned 2026-09-04: LCSC C135264, Extended, 51303 in stock.

p1 = io("p1", Net, optional = True)
p2 = io("p2", Net, optional = True)

Component(
    name = "SXN_SMNR4020_220M",
    footprint = File("SXN_SMNR4020_220M/IND-SMD_L4.0-W4.0_LQH44PN2R2MP0L.kicad_mod"),
    symbol = Symbol("SXN_SMNR4020_220M/SMNR4020-220M.kicad_sym"),
    prefix = "L",
    part = Part(mpn = "SMNR4020-220M", manufacturer = "SXN"),
    properties = {"LCSC": "C135264", "MPN": "SMNR4020-220M"},
    pins = {
        "1": p1,
        "2": p2,
    },
)
