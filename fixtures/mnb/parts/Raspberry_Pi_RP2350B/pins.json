 "source": "rp2350-datasheet.pdf section 1.2.3 Table 3 (GPIO functions, Bank 0); ADC channels from the pinout (GPIO40_ADC0 .. GPIO47_ADC7) and section 12.4",
 "rules": {
  "adc": "analog inputs only on GPIO40-47 (ADC0-7); nothing else can be an ADC input",
  "pio": "PIO0/1/2 can drive any GPIO, but each PIO block sees a 32-pin window set by GPIOBASE (0 -> GPIO0-31, 16 -> GPIO16-47); a bus driven by one state machine must fit one window",
  "sio": "plain GPIO on every pin",
  "pwm": "a PWM slice output on every GPIO (slice and channel fixed per pin)",
  "hardware_spi": "SPI0/SPI1 signals only on the listed pins per instance (RX, CSn, SCK, TX repeat every 4 GPIOs; SPI0 on 0-7, 16-23, 32-39; SPI1 on 8-15, 24-31, 40-47)",
  "hardware_uart": "UART0/UART1 TX/RX/CTS/RTS only on the listed pins; some pins carry a second TX/RX in F11",
  "hardware_i2c": "I2C0/I2C1 SDA/SCL only on the listed pins",
  "dedicated": "USB DP/DM, SWCLK/SWDIO, XIN/XOUT, RUN and the QSPI flash pins are NOT GPIOs and cannot be reassigned",
  "avoid": "GPIO0-3 carry JTAG when JTAG_FUNCSEL is enabled; GPIO12-19 carry HSTX; QMI CS1n on 0, 8, 19, 47; keep boot-strap and debug considerations in mind"
 },
