IOVDD = io("IOVDD", Net, optional = True)          # 3.3V digital IO supply (pins 5,15,24,29,41,50,60,76 - merged by name)
DVDD = io("DVDD", Net, optional = True)             # 1.1V core supply (pins 10,32,51 - merged by name) - EXTERNAL LDO, on-chip VREG disabled
QSPI_IOVDD = io("QSPI_IOVDD", Net, optional = True) # 3.3V QSPI IO supply
USB_OTP_VDD = io("USB_OTP_VDD", Net, optional = True)
ADC_AVDD = io("ADC_AVDD", Net, optional = True)
VREG_AVDD = io("VREG_AVDD", Net, optional = True)   # must still be powered even with on-chip VREG disabled (POR/BOD)
VREG_PGND = io("VREG_PGND", Net, optional = True)   # tie to GND always
VREG_LX = io("VREG_LX", Net, optional = True)       # NC — no inductor, external DVDD supply (datasheet Fig 21)
VREG_VIN = io("VREG_VIN", Net, optional = True)     # must still be powered even with on-chip VREG disabled (POR/BOD)
VREG_FB = io("VREG_FB", Net, optional = True)       # tie DIRECTLY to GND — disables on-chip VREG feedback (datasheet Fig 21)
USB_DM = io("USB_DM", Net, optional = True)
USB_DP = io("USB_DP", Net, optional = True)
