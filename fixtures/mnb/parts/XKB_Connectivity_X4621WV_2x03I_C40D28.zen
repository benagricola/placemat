# XKB_Connectivity_X4621WV_2x03I_C40D28 — component wrapper: local KiCad symbol + footprint,
# LCSC pinned in properties (feeds the JLC BOM/CPL fields).
#
# 2x3, 2.00 mm pitch THT header — the CAN-MODE jumper body, ported verbatim from the N17
# CAN-FD front end (same LCSC id, same footprint: HDR-TH_6P-P2.00-V-M-R2-C3-S2.00).
# Physical pad layout (verified from the fetched footprint, x/y in mm): 3 columns at
# x = -2/0/+2 (2 mm pitch), 2 rows at y = +1 (pins 1/3/5) and y = -1 (pins 2/4/6),
# also 2 mm apart — so a standard 2 mm-pitch shunt bridges an adjacent COLUMN pair
# within one row. Generic wrapper; the instantiating module assigns meaning per column.
p1 = io("p1", Net, optional = True)  # col 1, row top    (y=+1)
p2 = io("p2", Net, optional = True)  # col 1, row bottom (y=-1)
p3 = io("p3", Net, optional = True)  # col 2, row top    (y=+1)
p4 = io("p4", Net, optional = True)  # col 2, row bottom (y=-1)
p5 = io("p5", Net, optional = True)  # col 3, row top    (y=+1)
p6 = io("p6", Net, optional = True)  # col 3, row bottom (y=-1)

Component(
    name = "XKB_Connectivity_X4621WV_2x03I_C40D28",
    footprint = File("XKB_Connectivity_X4621WV_2x03I_C40D28/HDR-TH_6P-P2.00-V-M-R2-C3-S2.00.kicad_mod"),
    symbol = Symbol("XKB_Connectivity_X4621WV_2x03I_C40D28/X4621WV-2x03I-C40D28.kicad_sym"),
    prefix = "H",
    part = Part(mpn = "X4621WV-2x03I-C40D28", manufacturer = "XKB Connectivity"),
    properties = {"LCSC": "C706986", "MPN": "X4621WV-2x03I-C40D28"},
    pins = {
