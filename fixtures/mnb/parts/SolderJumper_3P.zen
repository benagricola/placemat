# 3-pin open-style solder jumper, SPDT throw pattern (KiCad standard Jumper.pretty footprint +
# the standard SolderJumper_3_Open symbol, both copied verbatim from the stdlib KiCad libraries).
# Not a BOM part (no LCSC id) - excluded from assembly outputs, like MountingHole_M3.
# Default state = OPEN (no pads bridged); bridging p2-p1 or p2-p3 with solder selects a throw.
# Pad/pin numbering (from the stock footprint+symbol): 1 = throw A (outer), 2 = common (centre),
# 3 = throw B (outer) - matches the physical pad layout left-to-right.

p1 = io("p1", Net, optional = True)
p2 = io("p2", Net, optional = True)
p3 = io("p3", Net, optional = True)

Component(
    name = "SolderJumper_3P",
    footprint = File("SolderJumper_3P/SolderJumper-3_P1.3mm_Open_Pad1.0x1.5mm.kicad_mod"),
    symbol = Symbol("SolderJumper_3P/SolderJumper_3_Open.kicad_sym"),
    prefix = "JP",
    part = Part(mpn = "SolderJumper-3_P1.3mm_Open", manufacturer = "generic"),
    pins = {
        "A": p1,
        "C": p2,
        "B": p3,
    },
)
