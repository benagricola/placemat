(version 1)
(rule "the 0201 match inductor's own lands [logic]"
  (condition "A.memberOf('logic') && B.memberOf('logic') && ((A.NetName == 'logic.RF_CHIP' && B.NetName == 'RF_50') || (A.NetName == 'RF_50' && B.NetName == 'logic.RF_CHIP'))")
  (constraint clearance (min 0.18mm)))
(rule "the 0201 RF_50 shunt's own lands [logic]"
  (condition "A.memberOf('logic') && B.memberOf('logic') && ((A.NetName == 'RF_50' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'RF_50'))")
  (constraint clearance (min 0.18mm)))
(rule "the RT1715's 0.4 mm-pitch balls (WL-CSP-9) [usbpd.tcpc]"
