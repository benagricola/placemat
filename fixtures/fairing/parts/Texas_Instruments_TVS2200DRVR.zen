    prefix = "U",
    part = Part(mpn = "TVS2200DRVR", manufacturer = "Texas Instruments"),
    properties = {"LCSC": "C523793", "MPN": "TVS2200DRVR"},
    pins = {
        "GND": GND,
        "IN": IN,
    },
)
