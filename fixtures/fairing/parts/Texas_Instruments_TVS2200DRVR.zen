GND = io("GND", Net, optional = True)
IN = io("IN", Net, optional = True)

Component(
    name = "Texas_Instruments_TVS2200DRVR",
    footprint = File("Texas_Instruments_TVS2200DRVR/WSON-6_L2.0-W2.0-P0.65-BL-EP.kicad_mod"),
