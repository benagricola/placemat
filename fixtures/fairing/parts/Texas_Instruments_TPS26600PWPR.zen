# Texas_Instruments_TPS26600PWPR - component wrapper: local KiCad symbol + footprint, LCSC pinned
# in properties (feeds the JLC BOM/CPL fields). Datasheet: Texas_Instruments-TPS26600PWPR_C544399.pdf

IN = io("IN", Net, optional = True)
UVLO = io("UVLO", Net, optional = True)
NC = io("NC", Net, optional = True)
OVP = io("OVP", Net, optional = True)
MODE = io("MODE", Net, optional = True)
SHDN = io("SHDN", Net, optional = True)
RTN = io("RTN", Net, optional = True)
GND = io("GND", Net, optional = True)
IMON = io("IMON", Net, optional = True)
ILIM = io("ILIM", Net, optional = True)
dVdT = io("dVdT", Net, optional = True)
FLT = io("FLT", Net, optional = True)
OUT = io("OUT", Net, optional = True)
EP = io("EP", Net, optional = True)

Component(
    name = "Texas_Instruments_TPS26600PWPR",
    footprint = File("Texas_Instruments_TPS26600PWPR/HTSSOP-16_L5.0-W4.4-P0.65-LS6.4-BL-EP2.5.kicad_mod"),
    symbol = Symbol("Texas_Instruments_TPS26600PWPR/TPS26600PWPR.kicad_sym"),
    prefix = "U",
    part = Part(mpn = "TPS26600PWPR", manufacturer = "Texas Instruments"),
    properties = {"LCSC": "C544399", "MPN": "TPS26600PWPR"},
    pins = {
