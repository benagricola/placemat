        "UVLO": UVLO,
        "NC": NC,
        "OVP": OVP,
        "MODE": MODE,
        "~{SHDN}": SHDN,
        "RTN": RTN,
        "GND": GND,
        "IMON": IMON,
        "ILIM": ILIM,
        "dVdT": dVdT,
        "~{FLT}": FLT,
        "OUT": OUT,
        "EP": EP,
    },
)
