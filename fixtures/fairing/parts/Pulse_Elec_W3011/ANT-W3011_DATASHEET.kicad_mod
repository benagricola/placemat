(module W3011-datasheet (layer F.Cu) (tedit 5DC5F6A4)
	(descr "Pulse W3011 1575MHz GNSS chip antenna, land from datasheet p7. THREE contacts: a 0.80 x 1.84 ground land at one end, and at the other a SPLIT pair of 0.80 x 0.65 lands 0.54 apart - pad 1 the feed, pad 2 ground - both under the one 0.62 x 1.36 terminal, which bridges them. The element is fed at a tap and shorted to ground through itself. Derived: pads sit 0.40 from the board edge and run 1.84 deep, being the 1.6 body plus the 0.12 the pads stand proud top and bottom, so the split is 0.65 + 0.54 + 0.65. Pad width along the axis is 0.80 and the two end pads outer edges are 3.20 apart, so centres at +/-1.20. -y is the board edge. The easyeda2kicad original has two pads and cannot land ANT_TRACE at all.")
	(tags "antenna gnss 1575MHz")
	(attr smd)
	(fp_text reference REF** (at 0.000 -1.900) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value W3011 (at 0.000 1.900) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 0.6 0.6) (thickness 0.1)))
	)
	(property "LCSC Part" "C6604735")
	(fp_line (start -1.60 -0.80) (end 1.60 -0.80) (layer F.Fab) (width 0.1))
	(fp_line (start 1.60 -0.80) (end 1.60 0.80) (layer F.Fab) (width 0.1))
	(fp_line (start 1.60 0.80) (end -1.60 0.80) (layer F.Fab) (width 0.1))
	(fp_line (start -1.60 0.80) (end -1.60 -0.80) (layer F.Fab) (width 0.1))
	(fp_line (start -0.60 -0.95) (end 0.60 -0.95) (layer F.SilkS) (width 0.12))
	(fp_line (start -0.60 0.95) (end 0.60 0.95) (layer F.SilkS) (width 0.12))
	(fp_circle (center -1.95 -0.95) (end -1.89 -0.95) (layer F.SilkS) (width 0.12))
	(pad 2 smd rect (at -1.200 0.000 0.00) (size 0.800 1.840) (layers F.Cu F.Paste F.Mask))
	(pad 1 smd rect (at 1.200 -0.595 0.00) (size 0.800 0.650) (layers F.Cu F.Paste F.Mask))
	(pad 2 smd rect (at 1.200 0.595 0.00) (size 0.800 0.650) (layers F.Cu F.Paste F.Mask))
	(fp_line (start -1.80 -1.10) (end 1.80 -1.10) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.80 -1.10) (end 1.80 1.10) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.80 1.10) (end -1.80 1.10) (layer F.CrtYd) (width 0.05))
	(fp_line (start -1.80 1.10) (end -1.80 -1.10) (layer F.CrtYd) (width 0.05))
	(model "${KIPRJMOD}/../../../parts/Pulse_Elec_W3011/ANT-SMD_L3.2-W1.6-2.step"
		(offset (xyz 0.000 0.000 0.000))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
