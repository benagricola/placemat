A1 = io("A1", Net, optional = True)
A0 = io("A0", Net, optional = True)
Alert = io("Alert", Net, optional = True)
SDA = io("SDA", Net, optional = True)
SCL = io("SCL", Net, optional = True)
VS_P = io("VS_P", Net, optional = True)
GND = io("GND", Net, optional = True)
VBUS = io("VBUS", Net, optional = True)
VIN_N = io("VIN_N", Net, optional = True)
VIN_P = io("VIN_P", Net, optional = True)

Component(
    name = "Texas_Instruments_INA226AIDGSR",
    footprint = File("Texas_Instruments_INA226AIDGSR/MSOP-10_L3.0-W3.0-P0.50-LS5.0-BL.kicad_mod"),
