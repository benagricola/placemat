# BME280; native source and hash in C92489/asset-provenance.json.

GND = io("GND", Net, optional = True)
CSB = io("CSB", Net, optional = True)
SDI = io("SDI", Net, optional = True)
SCK = io("SCK", Net, optional = True)
SDO = io("SDO", Net, optional = True)
VDDIO = io("VDDIO", Net, optional = True)
VDD = io("VDD", Net, optional = True)

Component(
